# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud:
# app -> Settings -> Secrets. Never commit the real values - this repo is public.

[connections.phd_db]
dialect = "mysql"
driver = "pymysql"
host = "YOUR_DB_HOST"
port = 3306
username = "YOUR_USER"
password = "YOUR_PASSWORD"
database = "YOUR_DATABASE"

[phd_mdcro]
# :today is filled in with today's date on every load / refresh
query = "SELECT * FROM PHD_MDCRO_Base WHERE DATE(DeliveryDate) = :today"
